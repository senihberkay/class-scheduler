{
  "version": 2,
  "builds": [
    {
      "src": "v2/frontend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "v2/frontend/build/index.html"
    }
  ],
  "buildCommand": "cd v2/frontend && npm install && npm run build",
  "outputDirectory": "v2/frontend/build",
  "installCommand": "cd v2/frontend && npm install"
}
